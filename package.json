{
  "name": "uaeu-blackboard-mcp",
  "version": "0.1.0",
  "description": "MCP server for UAEU Blackboard Learn (uaeu.blackboard.com): courses, assignments, discussions, messages, calendar, groups, content, announcements, assessments, grading and enrollments.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": ["mcp", "blackboard", "uaeu", "model-context-protocol"],
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmTb/uaeu-blackboard-mcp.git"
  },
  "bin": {
    "uaeu-blackboard-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "login": "node dist/cli.js login",
    "status": "node dist/cli.js status",
    "doctor": "node dist/cli.js doctor",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "ipaddr.js": "^2.5.0",
    "playwright-core": "^1.55.0",
    "unpdf": "^2.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
